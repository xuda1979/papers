\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Dyck--1 accuracy at reduced width $d = 32$ ($5$ seeds, mean $\pm $ std). Only DTFN--FULL and DTFN--Adaptive solve the task at this width; fixed--CFL local variants (U, MUSCL, WENO5) fail, and CPSA partially succeeds via its non--local window. This demonstrates that adaptive CFL is a sample--efficient alternative to widening the model.}}{20}{table.13}\protected@file@percent }
\newlabel{tab:adaptive-efficiency}{{13}{20}{Dyck--1 accuracy at reduced width $d = 32$ ($5$ seeds, mean $\pm $ std). Only DTFN--FULL and DTFN--Adaptive solve the task at this width; fixed--CFL local variants (U, MUSCL, WENO5) fail, and CPSA partially succeeds via its non--local window. This demonstrates that adaptive CFL is a sample--efficient alternative to widening the model}{table.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces SSM bridge: predicted vs actual spectral structure. The predicted top eigenvalue is $1.0$ (mass conservation mode); the actual top eigenvalue is $1.0004$--$1.0020$ across configurations, confirming conservation to finite--difference precision. The contraction rate (second eigenvalue) matches to within $0.09$. All configurations are stable (contraction $< 1$).}}{20}{table.14}\protected@file@percent }
\newlabel{tab:ssm-bridge}{{14}{20}{SSM bridge: predicted vs actual spectral structure. The predicted top eigenvalue is $1.0$ (mass conservation mode); the actual top eigenvalue is $1.0004$--$1.0020$ across configurations, confirming conservation to finite--difference precision. The contraction rate (second eigenvalue) matches to within $0.09$. All configurations are stable (contraction $< 1$)}{table.14}{}}
