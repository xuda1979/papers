\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Empirical convergence orders in float64. Upwind is first--order ($\approx 1$), MUSCL is second--order ($\approx 2$), and WENO5 reaches order $\approx 4.6$ at the first refinement before the measured order declines to $\approx 3$ as the error approaches the temporal--discretisation floor and the asymptotic regime ends.}}{19}{table.11}\protected@file@percent }
\newlabel{tab:weno5-order}{{11}{19}{Empirical convergence orders in float64. Upwind is first--order ($\approx 1$), MUSCL is second--order ($\approx 2$), and WENO5 reaches order $\approx 4.6$ at the first refinement before the measured order declines to $\approx 3$ as the error approaches the temporal--discretisation floor and the asymptotic regime ends}{table.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces FCT--DTFN convergence on smooth Gaussian advection (float64, $T = 0.5$, $v = 0.3$, CFL $= 0.3$). FCT with the analytic limiter achieves order $\approx 3$, sitting between MUSCL (order 2) and WENO5 (order 5), while inheriting the shock--capturing robustness of the low--order scheme. The learned limiter is trained on a single--step supervised target (see text).}}{19}{table.12}\protected@file@percent }
\newlabel{tab:fct-order}{{12}{19}{FCT--DTFN convergence on smooth Gaussian advection (float64, $T = 0.5$, $v = 0.3$, CFL $= 0.3$). FCT with the analytic limiter achieves order $\approx 3$, sitting between MUSCL (order 2) and WENO5 (order 5), while inheriting the shock--capturing robustness of the low--order scheme. The learned limiter is trained on a single--step supervised target (see text)}{table.12}{}}
