\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Wall--clock forward pass time vs sequence length. DTFN--U (blue) is the fastest model at every length; the Transformer's $\mathcal  {O}(L^2)$ scaling appears beyond $L=2048$.}}{11}{figure.6}\protected@file@percent }
\newlabel{fig:scaling}{{6}{11}{Wall--clock forward pass time vs sequence length. DTFN--U (blue) is the fastest model at every length; the Transformer's $\mathcal {O}(L^2)$ scaling appears beyond $L=2048$}{figure.6}{}}
\@writefile{toc}{\contentsline {paragraph}{Results.}{11}{section*.10}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Adversarial stability: $\ell _1$ contraction ratio $\|\delta _{\mathrm  {out}}\|_1 / \|\delta _{\mathrm  {in}}\|_1$ for random and FGSM perturbations of the input mass $p^0$, across perturbation magnitude $\varepsilon $. Theorem~\ref {thm:l1} predicts ratio $\le 1$. DTFN--U and --B achieve ratios within $[0.88, 1.20]$, confirming the $1$--Lipschitz guarantee up to the positivity--floor error.}}{11}{table.9}\protected@file@percent }
\newlabel{tab:stability}{{9}{11}{Adversarial stability: $\ell _1$ contraction ratio $\|\delta _{\mathrm {out}}\|_1 / \|\delta _{\mathrm {in}}\|_1$ for random and FGSM perturbations of the input mass $p^0$, across perturbation magnitude $\varepsilon $. Theorem~\ref {thm:l1} predicts ratio $\le 1$. DTFN--U and --B achieve ratios within $[0.88, 1.20]$, confirming the $1$--Lipschitz guarantee up to the positivity--floor error}{table.9}{}}
\@writefile{toc}{\contentsline {paragraph}{CFL certificate.}{11}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Adversarial stability of the DTFN forward map (Theorem~\ref {thm:l1}). The $\ell _1$ contraction ratio $\|\delta _{\mathrm  {out}}\|_1 / \|\delta _{\mathrm  {in}}\|_1$ is plotted against perturbation magnitude $\varepsilon $ for random (left) and FGSM (right) attacks. The dashed line at $1.0$ is the theoretical bound from Theorem~\ref {thm:l1}. DTFN--U (blue) and DTFN--B (orange) maintain ratios within $[0.88, 1.20]$; DTFN--FULL (green) within $[0.95, 1.25]$, with the small excess attributable to the MUSCL slope reconstruction and the positivity floor. All variants confirm the $1$--Lipschitz guarantee up to the positivity--floor error.}}{12}{figure.7}\protected@file@percent }
\newlabel{fig:stability}{{7}{12}{Adversarial stability of the DTFN forward map (Theorem~\ref {thm:l1}). The $\ell _1$ contraction ratio $\|\delta _{\mathrm {out}}\|_1 / \|\delta _{\mathrm {in}}\|_1$ is plotted against perturbation magnitude $\varepsilon $ for random (left) and FGSM (right) attacks. The dashed line at $1.0$ is the theoretical bound from Theorem~\ref {thm:l1}. DTFN--U (blue) and DTFN--B (orange) maintain ratios within $[0.88, 1.20]$; DTFN--FULL (green) within $[0.95, 1.25]$, with the small excess attributable to the MUSCL slope reconstruction and the positivity floor. All variants confirm the $1$--Lipschitz guarantee up to the positivity--floor error}{figure.7}{}}
