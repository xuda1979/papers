\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Adversarial stability: $\ell _1$ contraction ratio $\|\delta _{\mathrm  {out}}\|_1 / \|\delta _{\mathrm  {in}}\|_1$ for random and FGSM perturbations of the input mass $p^0$, across perturbation magnitude $\varepsilon $. Theorem~\ref {thm:l1} predicts ratio $\le 1$. DTFN--U and --B achieve ratios within $[0.88, 1.20]$, confirming the $1$--Lipschitz guarantee up to the positivity--floor error.}}{18}{table.10}\protected@file@percent }
\newlabel{tab:stability}{{10}{18}{Adversarial stability: $\ell _1$ contraction ratio $\|\delta _{\mathrm {out}}\|_1 / \|\delta _{\mathrm {in}}\|_1$ for random and FGSM perturbations of the input mass $p^0$, across perturbation magnitude $\varepsilon $. Theorem~\ref {thm:l1} predicts ratio $\le 1$. DTFN--U and --B achieve ratios within $[0.88, 1.20]$, confirming the $1$--Lipschitz guarantee up to the positivity--floor error}{table.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Adversarial stability of the DTFN forward map (Theorem~\ref {thm:l1}). The $\ell _1$ contraction ratio $\|\delta _{\mathrm  {out}}\|_1 / \|\delta _{\mathrm  {in}}\|_1$ is plotted against perturbation magnitude $\varepsilon $ for random (left) and FGSM (right) attacks. The dashed line at $1.0$ is the theoretical bound from Theorem~\ref {thm:l1}. DTFN--U (blue) and DTFN--B (orange) maintain ratios within $[0.88, 1.20]$; DTFN--FULL (green) within $[0.95, 1.25]$, with the small excess attributable to the MUSCL slope reconstruction and the positivity floor. All variants confirm the $1$--Lipschitz guarantee up to the positivity--floor error.}}{18}{figure.7}\protected@file@percent }
\newlabel{fig:stability}{{7}{18}{Adversarial stability of the DTFN forward map (Theorem~\ref {thm:l1}). The $\ell _1$ contraction ratio $\|\delta _{\mathrm {out}}\|_1 / \|\delta _{\mathrm {in}}\|_1$ is plotted against perturbation magnitude $\varepsilon $ for random (left) and FGSM (right) attacks. The dashed line at $1.0$ is the theoretical bound from Theorem~\ref {thm:l1}. DTFN--U (blue) and DTFN--B (orange) maintain ratios within $[0.88, 1.20]$; DTFN--FULL (green) within $[0.95, 1.25]$, with the small excess attributable to the MUSCL slope reconstruction and the positivity floor. All variants confirm the $1$--Lipschitz guarantee up to the positivity--floor error}{figure.7}{}}
