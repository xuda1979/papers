\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Ablation on $K$ for DTFN--U on Dyck--1. Even $K=1$ achieves $99.98\%$ token accuracy; performance is flat across $K\in \{2,3,5,8\}$ ($99.86\%$) and rises slightly at $K=12$ ($99.98\%$). The loss is minimised at the extremes ($K=1$ and $K=12$); we adopt $K=3$ as a robust middle value.}}{16}{table.7}\protected@file@percent }
\newlabel{tab:ablation-K}{{7}{16}{Ablation on $K$ for DTFN--U on Dyck--1. Even $K=1$ achieves $99.98\%$ token accuracy; performance is flat across $K\in \{2,3,5,8\}$ ($99.86\%$) and rises slightly at $K=12$ ($99.98\%$). The loss is minimised at the extremes ($K=1$ and $K=12$); we adopt $K=3$ as a robust middle value}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Ablation on FluxNet width (top, depth $D=2$ fixed) and depth (bottom, width $W=32$ fixed) for DTFN--U on Dyck--1. Token accuracy is robust across a $16\times $ range of widths and from $D=1$ to $D=4$; the dyadic--input Softplus MLP saturates quickly because the Dyck--1 counting task requires only a monotone threshold.}}{16}{table.8}\protected@file@percent }
\newlabel{tab:ablation-fluxnet}{{8}{16}{Ablation on FluxNet width (top, depth $D=2$ fixed) and depth (bottom, width $W=32$ fixed) for DTFN--U on Dyck--1. Token accuracy is robust across a $16\times $ range of widths and from $D=1$ to $D=4$; the dyadic--input Softplus MLP saturates quickly because the Dyck--1 counting task requires only a monotone threshold}{table.8}{}}
