\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mass conservation and positivity across $50$ update steps with random FluxNet parameters. Flux--only variants (U, B, MUSCL, WENO5) are conservative to float32 round--off ($\sim 10^{-8}$). FCT and CPSA are conservative to $\sim 10^{-4}$--$10^{-5}$ due to the learned--limiter sigmoid / softmax computations in float32 (see text). DTFN--Adaptive is conservative to $\sim 10^{-5}$: with random FluxNet parameters the learned $\lambda _i$ are close to constant at initialisation, so the Theorem~\ref {thm:adaptive} residual $\DOTSB \sum@ \slimits@ _i (\lambda _{i+1}-\lambda _i) F_{i+1/2}$ is small and dominated by float32 round--off in this regime. DTFN--FULL has a non--conservative source term by design (Section~\ref {sec:method}).}}{11}{table.1}\protected@file@percent }
\newlabel{tab:conservation}{{1}{11}{Mass conservation and positivity across $50$ update steps with random FluxNet parameters. Flux--only variants (U, B, MUSCL, WENO5) are conservative to float32 round--off ($\sim 10^{-8}$). FCT and CPSA are conservative to $\sim 10^{-4}$--$10^{-5}$ due to the learned--limiter sigmoid / softmax computations in float32 (see text). DTFN--Adaptive is conservative to $\sim 10^{-5}$: with random FluxNet parameters the learned $\lambda _i$ are close to constant at initialisation, so the Theorem~\ref {thm:adaptive} residual $\sum _i (\lambda _{i+1}-\lambda _i) F_{i+1/2}$ is small and dominated by float32 round--off in this regime. DTFN--FULL has a non--conservative source term by design (Section~\ref {sec:method})}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mass conservation, positivity, and maximum principle over $50$ update steps with random FluxNet parameters. Left: total mass is constant to machine precision. Middle: minimum and maximum mass stay bounded. Right: relative conservation error stays at float32 precision ($\sim 10^{-8}$ for flux--only variants; $\sim 10^{-4}$--$10^{-5}$ for FCT/CPSA/Adaptive, see text).}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:conservation}{{2}{11}{Mass conservation, positivity, and maximum principle over $50$ update steps with random FluxNet parameters. Left: total mass is constant to machine precision. Middle: minimum and maximum mass stay bounded. Right: relative conservation error stays at float32 precision ($\sim 10^{-8}$ for flux--only variants; $\sim 10^{-4}$--$10^{-5}$ for FCT/CPSA/Adaptive, see text)}{figure.2}{}}
