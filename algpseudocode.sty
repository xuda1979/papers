\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algpseudocode}[2026/04/01 Minimal local fallback]

\newcounter{ALG@line}
\newenvironment{algorithmic}[1][]{%
  \setcounter{ALG@line}{0}%
  \begin{list}{}{\leftmargin=2em \itemsep=0.2ex \parsep=0pt \topsep=0.4ex}%
}{%
  \end{list}%
}

% Use a plain counter step here. The minimal fallback does not support
% per-algorithm hyperref anchors, and \refstepcounter creates duplicate
% PDF destinations when multiple algorithms restart numbering at 1.
\newcommand{\State}{\stepcounter{ALG@line}\item[\arabic{ALG@line}.]}
\newcommand{\For}[1]{\State \textbf{for} #1 \textbf{do}\begin{list}{}{\leftmargin=2em \itemsep=0.2ex \parsep=0pt \topsep=0.2ex}}
\newcommand{\EndFor}{\end{list}}
\newcommand{\If}[1]{\State \textbf{if} #1 \textbf{then}\begin{list}{}{\leftmargin=2em \itemsep=0.2ex \parsep=0pt \topsep=0.2ex}}
\newcommand{\EndIf}{\end{list}}
\newcommand{\algorithmiccomment}[1]{\hfill #1}
\def\algrenewcommand#1{\renewcommand#1}
