\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Long‑range retrieval accuracy versus sequence length $N$ with fixed $n_{kv}\!=\!16$ and latent budget $K\!=\!64$. \textsc  {LST}{}, \textsc  {LST}-G{}, the SSM, and the Transformer all hold at $\sim \!84\%$ up to $N\!=\!1024$; only Linformer (static latent) drops sharply at $N\!=\!1024$. Runs beyond $N\!=\!1024$ exceeded the available MPS memory on this machine and are omitted. With $n_{kv}\!=\!16$ the SSM state is large enough to store the pairs, so the separation predicted by \Cref  {thm:mqar} does not bite in this range.}}{13}{figure.8}\protected@file@percent }
\newlabel{fig:long_range}{{8}{13}{Long‑range retrieval accuracy versus sequence length $N$ with fixed $n_{kv}\!=\!16$ and latent budget $K\!=\!64$. \LST {}, \LST -G{}, the SSM, and the Transformer all hold at $\sim \!84\%$ up to $N\!=\!1024$; only Linformer (static latent) drops sharply at $N\!=\!1024$. Runs beyond $N\!=\!1024$ exceeded the available MPS memory on this machine and are omitted. With $n_{kv}\!=\!16$ the SSM state is large enough to store the pairs, so the separation predicted by \Cref {thm:mqar} does not bite in this range}{figure.8}{}}
\newlabel{fig:long_range@cref}{{[figure][8][]8}{[1][12][]13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Accuracy versus noise ratio at fixed $N\!=\!256$, $n_{kv}\!=\!16$. From $25\%$ to $75\%$ noise the five methods are within $2$ points of each other at $\sim \!79$--$80\%$. At $0\%$ noise \textsc  {LST}{} drops to $50.4\%$ (an optimisation outlier; see text). At $90\%$ noise the SSM is most robust ($80.1\%$), slightly above \textsc  {LST}{} ($78.4\%$). Outside the $0\%$ outlier, the noise experiment does not strongly discriminate between the architectures in this regime.}}{13}{figure.9}\protected@file@percent }
\newlabel{fig:noise}{{9}{13}{Accuracy versus noise ratio at fixed $N\!=\!256$, $n_{kv}\!=\!16$. From $25\%$ to $75\%$ noise the five methods are within $2$ points of each other at $\sim \!79$--$80\%$. At $0\%$ noise \LST {} drops to $50.4\%$ (an optimisation outlier; see text). At $90\%$ noise the SSM is most robust ($80.1\%$), slightly above \LST {} ($78.4\%$). Outside the $0\%$ outlier, the noise experiment does not strongly discriminate between the architectures in this regime}{figure.9}{}}
\newlabel{fig:noise@cref}{{[figure][9][]9}{[1][13][]13}{}{}{}}
