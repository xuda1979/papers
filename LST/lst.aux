\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Mean gate value $g_t$ in \textsc  {LST}-G{} on MQAR with $n_{kv}\!=\!64$. \emph  {Left:} per‑position‑type mean gate by layer; the gate is highest at key/query positions and lowest at value positions. \emph  {Right:} per‑position mean gate across the sequence; the gate oscillates between key (high) and value (low) positions in the KV region and stays high in the query region. This confirms the adaptive routing prediction of \Cref  {prop:route}.}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:gate_analysis}{{7}{10}{Mean gate value $g_t$ in \LST -G{} on MQAR with $n_{kv}\!=\!64$. \emph {Left:} per‑position‑type mean gate by layer; the gate is highest at key/query positions and lowest at value positions. \emph {Right:} per‑position mean gate across the sequence; the gate oscillates between key (high) and value (low) positions in the KV region and stays high in the query region. This confirms the adaptive routing prediction of \Cref {prop:route}}{figure.7}{}}
