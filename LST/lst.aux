\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Effect of latent dimension $K$ at $n_{kv}\!=\!96$. \textsc  {LST\,}-\textsc  {AA}{} with $K\!=\!32$ matches \textsc  {LST\,}-\textsc  {AA}{} with $K\!=\!96$ ($79.6\%$ vs $80.3\%$), recovering the unbounded‑$K$ accuracy at ${1}/{3}$ the latent cost. \textsc  {LST\,}-\textsc  {CA}{} at $K\!=\!96$ reaches only $56.7\%$, still well below \textsc  {LST\,}-\textsc  {AA}{} at $K\!=\!32$, indicating that a larger budget alone does not close the gap without content‑adaptive routing. \textsc  {LST}{} was not run at $K\!=\!96$ in this sweep.}}{15}{figure.11}\protected@file@percent }
\newlabel{fig:content_adaptive_k}{{11}{15}{Effect of latent dimension $K$ at $n_{kv}\!=\!96$. \LSTAA {} with $K\!=\!32$ matches \LSTAA {} with $K\!=\!96$ ($79.6\%$ vs $80.3\%$), recovering the unbounded‑$K$ accuracy at ${1}/{3}$ the latent cost. \LSTCA {} at $K\!=\!96$ reaches only $56.7\%$, still well below \LSTAA {} at $K\!=\!32$, indicating that a larger budget alone does not close the gap without content‑adaptive routing. \LST {} was not run at $K\!=\!96$ in this sweep}{figure.11}{}}
