\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces MQAR accuracy versus $n_{kv}$ with fixed latent budget $K\!=\!32$. At $n_{kv}\!=\!96$, \textsc  {LST\,}-\textsc  {AA}{} (adaptive budget) reaches $79.6\%$, beating the Transformer ($46.6\%$) by $33$ points and the original \textsc  {LST}{} ($56.6\%$) by $23$ points. All methods plateau at $n_{kv}\!=\!128$ where the large key vocabulary makes keys nearly orthogonal.}}{14}{figure.10}\protected@file@percent }
\newlabel{fig:content_adaptive}{{10}{14}{MQAR accuracy versus $n_{kv}$ with fixed latent budget $K\!=\!32$. At $n_{kv}\!=\!96$, \LSTAA {} (adaptive budget) reaches $79.6\%$, beating the Transformer ($46.6\%$) by $33$ points and the original \LST {} ($56.6\%$) by $23$ points. All methods plateau at $n_{kv}\!=\!128$ where the large key vocabulary makes keys nearly orthogonal}{figure.10}{}}
\newlabel{fig:content_adaptive@cref}{{[figure][10][]10}{[1][14][]14}{}{}{}}
