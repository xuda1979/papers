\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces MQAR accuracy (\%) as a function of the number of key--value pairs $n_{kv}$. Best in \textbf  {bold}. Chance is $1/V_v\!\in \!\{0.4\%,0.8\%,1.6\%\}$ for $V_v\!\in \!\{256,128,64\}$. The $n_{kv}\!=\!32$ column is near chance for every method under the $600$‑step budget (see text); it is excluded from the cross‑model ranking. \textsc  {LST}-G{} (\Cref  {sec:gated}) matches \textsc  {LST}{} at $n_{kv}\!\in \!\{16,64\}$ and is within noise at $n_{kv}\!=\!96$; both plateau at $K\!=\!128$ in \Cref  {sec:ablation}.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:mqar}{{2}{10}{MQAR accuracy (\%) as a function of the number of key--value pairs $n_{kv}$. Best in \textbf {bold}. Chance is $1/V_v\!\in \!\{0.4\%,0.8\%,1.6\%\}$ for $V_v\!\in \!\{256,128,64\}$. The $n_{kv}\!=\!32$ column is near chance for every method under the $600$‑step budget (see text); it is excluded from the cross‑model ranking. \LST -G{} (\Cref {sec:gated}) matches \LST {} at $n_{kv}\!\in \!\{16,64\}$ and is within noise at $n_{kv}\!=\!96$; both plateau at $K\!=\!128$ in \Cref {sec:ablation}}{table.2}{}}
\newlabel{tab:mqar@cref}{{[table][2][]2}{[1][9][]10}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Forward+backward time (ms/step) and peak memory (MB) at $N\!=\!4096$, batch size 4. \textsc  {LST}{} is $8\times $ faster than the Transformer and $3\times $ faster than the SSM, at roughly $2\times $ the memory of each (the latent cache dominates the memory footprint). Linformer is faster still but uses the most memory due to its learned down/up projections.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:throughput}{{3}{10}{Forward+backward time (ms/step) and peak memory (MB) at $N\!=\!4096$, batch size 4. \LST {} is $8\times $ faster than the Transformer and $3\times $ faster than the SSM, at roughly $2\times $ the memory of each (the latent cache dominates the memory footprint). Linformer is faster still but uses the most memory due to its learned down/up projections}{table.3}{}}
