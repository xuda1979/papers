\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Toy-model Page curves ($S_0=12$ bits). The \textsc  {HMC}\xspace  {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs.}}{40}{figure.caption.59}\protected@file@percent }
\newlabel{fig:page_curve}{{3}{40}{Toy-model Page curves ($S_0=12$ bits). The \HMC {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs}{figure.caption.59}{}}
\newlabel{fig:page_curve@cref}{{[figure][3][]3}{[1][39][]40}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm  BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow  {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \Cref  {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\cref  {sec:page_theorem}).}}{40}{figure.caption.60}\protected@file@percent }
\newlabel{fig:page_curve_exact}{{4}{40}{Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \Cref {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\cref {sec:page_theorem})}{figure.caption.60}{}}
\newlabel{fig:page_curve_exact@cref}{{[figure][4][]4}{[1][39][]40}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces $g^{(2)}(\Delta u)$ (defined in \Cref  {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \Cref  {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm  mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory.}}{41}{figure.caption.61}\protected@file@percent }
\newlabel{fig:g2}{{5}{41}{$g^{(2)}(\Delta u)$ (defined in \Cref {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \Cref {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory}{figure.caption.61}{}}
\newlabel{fig:g2@cref}{{[figure][5][]5}{[1][39][]41}{}{}{}}
