\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textup  {\textsc  {HMC}}\xspace  {} structure: A sequence of local isometries $U_k$. Each $U_k$ acts on its causal past, comprising incoming vacuum modes $V_k$, memory $M_{k-1}$, and interior modes $I_{k-1}$. The memory $M$ (stretched horizon) mediates entanglement between the interior $I$ (infalling modes) and the radiation $O$. The shrinking memory dimension is realized unitarily by embedding the code subspace and dilating it via the auxiliary system $E_k$, such that the total output is $O_k = R_k \otimes E_k$.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:comb_structure}{{2}{15}{\HMC {} structure: A sequence of local isometries $U_k$. Each $U_k$ acts on its causal past, comprising incoming vacuum modes $V_k$, memory $M_{k-1}$, and interior modes $I_{k-1}$. The memory $M$ (stretched horizon) mediates entanglement between the interior $I$ (infalling modes) and the radiation $O$. The shrinking memory dimension is realized unitarily by embedding the code subspace and dilating it via the auxiliary system $E_k$, such that the total output is $O_k = R_k \otimes E_k$}{figure.2}{}}
