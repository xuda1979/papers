\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Toy-model Page curves ($S_0=12$ bits). The \textup  {\textsc  {HMC}}\xspace  {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs.}}{47}{figure.4}\protected@file@percent }
\newlabel{fig:page_curve}{{4}{47}{Toy-model Page curves ($S_0=12$ bits). The \HMC {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm  BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow  {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \ref {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\ref {sec:page_theorem}).}}{47}{figure.5}\protected@file@percent }
\newlabel{fig:page_curve_exact}{{5}{47}{Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \Cref {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\cref {sec:page_theorem})}{figure.5}{}}
