\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces $g^{(2)}(\Delta u)$ (defined in \ref {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \ref {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm  mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory.}}{47}{figure.6}\protected@file@percent }
\newlabel{fig:g2}{{6}{47}{$g^{(2)}(\Delta u)$ (defined in \Cref {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \Cref {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory}{figure.6}{}}
