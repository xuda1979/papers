{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/carter_transport_certificate.schema.json",
  "title": "Renormalized Carter transport cone certificate",
  "type": "object",
  "required": ["metadata", "renormalized_variables", "cone_identity", "torus_atlas", "quantization"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "spin", "symbol_class", "trapped_scale"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spin": { "type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$" },
        "symbol_class": { "type": "string", "minLength": 1 },
        "trapped_scale": { "$ref": "#/$defs/interval" }
      }
    },
    "renormalized_variables": {
      "type": "object",
      "required": ["e", "l", "q", "q_nonnegative_margin"],
      "additionalProperties": false,
      "properties": {
        "e": { "type": "string", "minLength": 1 },
        "l": { "type": "string", "minLength": 1 },
        "q": { "type": "string", "minLength": 1 },
        "q_nonnegative_margin": { "$ref": "#/$defs/interval" }
      }
    },
    "cone_identity": {
      "type": "object",
      "required": [
        "target_density",
        "delta",
        "transport_symbol",
        "sum_of_squares",
        "superradiant_squares",
        "constraint_squares",
        "remainder_bound",
        "positive_margin"
      ],
      "additionalProperties": false,
      "properties": {
        "target_density": { "type": "string", "minLength": 1 },
        "delta": { "$ref": "#/$defs/interval" },
        "transport_symbol": { "type": "string", "minLength": 1 },
        "sum_of_squares": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "superradiant_squares": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraint_squares": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "remainder_bound": { "$ref": "#/$defs/interval" },
        "positive_margin": { "$ref": "#/$defs/interval" }
      }
    },
    "torus_atlas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chart", "nonresonant_coboundary_error", "resonant_margin"],
        "additionalProperties": false,
        "properties": {
          "chart": { "type": "string", "minLength": 1 },
          "nonresonant_coboundary_error": { "$ref": "#/$defs/interval" },
          "resonant_margin": { "$ref": "#/$defs/interval" }
        }
      }
    },
    "quantization": {
      "type": "object",
      "required": ["scheme", "subprincipal_remainder", "garding_margin", "derivative_loss"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "subprincipal_remainder": { "$ref": "#/$defs/interval" },
        "garding_margin": { "$ref": "#/$defs/interval" },
        "derivative_loss": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "string",
      "pattern": "^\\[\\s*-?[0-9]+(/[1-9][0-9]*)?\\s*,\\s*-?[0-9]+(/[1-9][0-9]*)?\\s*\\]$"
    }
  }
}
