{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kerr_certificate.schema.json",
  "title": "Machine-checkable Kerr certificate scaffold",
  "type": "object",
  "required": [
    "metadata",
    "energy_positivity",
    "morawetz_positivity",
    "trapped_superradiant",
    "nonlinear_null_hierarchy",
    "compatibility"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "spin", "sobolev_index", "weight", "frequency_decomposition", "symbol_class"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spin": { "type": "string", "pattern": "^-?[0-9]+(/[1-9][0-9]*)?$" },
        "sobolev_index": { "type": "integer", "minimum": 8 },
        "weight": { "type": "string", "minLength": 1 },
        "frequency_decomposition": { "type": "string", "minLength": 1 },
        "symbol_class": { "type": "string", "minLength": 1 }
      }
    },
    "energy_positivity": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/energyEntry" }
    },
    "morawetz_positivity": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/morawetzEntry" }
    },
    "trapped_superradiant": {
      "type": "object",
      "required": ["torus_charts", "symbol_globalization"],
      "additionalProperties": false,
      "properties": {
        "torus_charts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/torusChart" }
        },
        "symbol_globalization": {
          "type": "object",
          "required": ["escape_function", "symbol_class", "fixed_neighborhood_remainder", "all_remainders_absorbable"],
          "additionalProperties": false,
          "properties": {
            "escape_function": { "type": "string", "minLength": 1 },
            "symbol_class": { "type": "string", "minLength": 1 },
            "fixed_neighborhood_remainder": { "$ref": "#/$defs/interval" },
            "all_remainders_absorbable": { "const": true }
          }
        }
      }
    },
    "nonlinear_null_hierarchy": {
      "type": "object",
      "required": [
        "all_quadratic_terms_classified",
        "all_cubic_terms_classified",
        "source_decay_eta",
        "source_constant",
        "modulation_decay_eta",
        "modulation_constant"
      ],
      "additionalProperties": false,
      "properties": {
        "all_quadratic_terms_classified": { "const": true },
        "all_cubic_terms_classified": { "const": true },
        "source_decay_eta": { "$ref": "#/$defs/interval" },
        "source_constant": { "$ref": "#/$defs/interval" },
        "modulation_decay_eta": { "$ref": "#/$defs/interval" },
        "modulation_constant": { "$ref": "#/$defs/interval" }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "sobolev_index",
        "weight",
        "frequency_decomposition",
        "symbol_class",
        "max_derivative_loss",
        "available_derivative_buffer"
      ],
      "additionalProperties": false,
      "properties": {
        "sobolev_index": { "type": "integer", "minimum": 8 },
        "weight": { "type": "string", "minLength": 1 },
        "frequency_decomposition": { "type": "string", "minLength": 1 },
        "symbol_class": { "type": "string", "minLength": 1 },
        "max_derivative_loss": { "type": "integer", "minimum": 0 },
        "available_derivative_buffer": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "string",
      "pattern": "^\\[\\s*-?[0-9]+(/[1-9][0-9]*)?\\s*,\\s*-?[0-9]+(/[1-9][0-9]*)?\\s*\\]$"
    },
    "energyEntry": {
      "type": "object",
      "required": ["sector", "chart", "gram_identity", "lower_bound", "remainder_absorption"],
      "additionalProperties": false,
      "properties": {
        "sector": { "type": "string", "minLength": 1 },
        "chart": { "type": "string", "minLength": 1 },
        "gram_identity": { "type": "string", "minLength": 1 },
        "lower_bound": { "$ref": "#/$defs/interval" },
        "remainder_absorption": { "$ref": "#/$defs/interval" }
      }
    },
    "morawetzEntry": {
      "type": "object",
      "required": ["channel", "chart", "square_decomposition", "bulk_lower_bound", "all_remainders_absorbable"],
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "minLength": 1 },
        "chart": { "type": "string", "minLength": 1 },
        "square_decomposition": { "type": "string", "minLength": 1 },
        "bulk_lower_bound": { "$ref": "#/$defs/interval" },
        "all_remainders_absorbable": { "const": true }
      }
    },
    "torusChart": {
      "type": "object",
      "required": ["chart", "fourier_polynomial", "approximation_error", "resonant_average_lower_bound"],
      "additionalProperties": false,
      "properties": {
        "chart": { "type": "string", "minLength": 1 },
        "fourier_polynomial": { "type": "string", "minLength": 1 },
        "approximation_error": { "$ref": "#/$defs/interval" },
        "resonant_average_lower_bound": { "$ref": "#/$defs/interval" }
      }
    }
  }
}
