\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Status and target regime for Kerr stability as a function of dimensionless spin $\chi = a/M$. The green region indicates the \emph  {conjectured} nonlinear stability range $0 \leq \chi < 1$ addressed by the roadmap in this paper. At extremality $\chi = 1$, the Aretakis instability obstructs stability. The blue curve illustrates the expected degradation of decay rates as $\chi \to 1$.}}{11}{figure.2}\protected@file@percent }
\newlabel{fig:stability-status}{{2}{11}{Status and target regime for Kerr stability as a function of dimensionless spin $\chi = a/M$. The green region indicates the \emph {conjectured} nonlinear stability range $0 \leq \chi < 1$ addressed by the roadmap in this paper. At extremality $\chi = 1$, the Aretakis instability obstructs stability. The blue curve illustrates the expected degradation of decay rates as $\chi \to 1$}{figure.2}{}}
\newlabel{fig:stability-status@cref}{{[figure][2][]2}{[1][10][]11}}
