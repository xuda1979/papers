\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The conformal sealing of the Jang bubbles. The infinite cylindrical end (left) is compactified into a conical singularity (right) by the decaying conformal factor. The cone angle satisfies $\Theta > 2\pi $ (angle excess); however, the singularity has zero $p$-capacity for $1 < p < 3$ and is therefore removable for the AMO analysis.}}{345}{figure.6}\protected@file@percent }
\newlabel{fig:ConformalSealing}{{6}{345}{The conformal sealing of the Jang bubbles. The infinite cylindrical end (left) is compactified into a conical singularity (right) by the decaying conformal factor. The cone angle satisfies $\Theta > 2\pi $ (angle excess); however, the singularity has zero $p$-capacity for $1 < p < 3$ and is therefore removable for the AMO analysis}{figure.6}{}}
\newlabel{fig:ConformalSealing@cref}{{[figure][6][]6}{[1][344][]345}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The conformal sealing process. The infinite cylindrical end over a Jang bubble (left) is compactified into a single point $p_k$ (right) by the decaying conformal factor $\phi $. Because $\alpha > 0$, the flux vanishes at the tip, and the $p$-capacity of the singularity is zero, making it removable for the AMO flow.}}{345}{figure.7}\protected@file@percent }
\newlabel{fig:conical}{{7}{345}{The conformal sealing process. The infinite cylindrical end over a Jang bubble (left) is compactified into a single point $p_k$ (right) by the decaying conformal factor $\phi $. Because $\alpha > 0$, the flux vanishes at the tip, and the $p$-capacity of the singularity is zero, making it removable for the AMO flow}{figure.7}{}}
