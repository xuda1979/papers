\ProvidesPackage{cleveref}[2026/04/17 minimal fallback cleveref]
\DeclareOption*{}
\ProcessOptions\relax
\RequirePackage{hyperref}

% Minimal compatibility shim for environments where full cleveref is absent.
\providecommand{\cref}[1]{\ref{#1}}
\providecommand{\Cref}[1]{\ref{#1}}
\providecommand{\cpageref}[1]{\pageref{#1}}
\providecommand{\Cpageref}[1]{\pageref{#1}}
\providecommand{\crefname}[3]{}
\providecommand{\Crefname}[3]{}
\providecommand{\namecref}[1]{\ref{#1}}
\providecommand{\nameCref}[1]{\ref{#1}}
\providecommand{\labelcref}[1]{\ref{#1}}
\providecommand{\labelcpageref}[1]{\pageref{#1}}

\endinput
