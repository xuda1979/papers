\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Numerical verification of AM-Penrose saturation for Kerr black holes with $M = 1$, computed via \texttt  {kerr\_verification.py}. The ratio $M/\mathcal  {B} = 1$ to machine precision ($<10^{-15}$) for all sub-extremal spin values, confirming that Kerr saturates the inequality exactly. The sub-extremality ratio $A/(8\pi |J|) > 1$ for all cases, approaching 1 in the extremal limit $a \to M$.}}{200}{table.8}\protected@file@percent }
\newlabel{tab:kerr-verification}{{8}{200}{Numerical verification of AM-Penrose saturation for Kerr black holes with $M = 1$, computed via \texttt {kerr\_verification.py}. The ratio $M/\mathcal {B} = 1$ to machine precision ($<10^{-15}$) for all sub-extremal spin values, confirming that Kerr saturates the inequality exactly. The sub-extremality ratio $A/(8\pi |J|) > 1$ for all cases, approaching 1 in the extremal limit $a \to M$}{table.8}{}}
\def\@LN@column{1}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.4}Worked Example: Explicit Verification for Kerr}{201}{subsection.A.4}\protected@file@percent }
