\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Toy-model Page curves ($S_0=12$ bits). The \textsc  {HMC}\xspace  {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs.}}{46}{figure.4}\protected@file@percent }
\newlabel{fig:page_curve}{{4}{46}{Toy-model Page curves ($S_0=12$ bits). The \HMC {} model (blue), assuming strong scrambling (P2, idealized Haar mixing) and adiabatic transfer (P4), follows the unitary Page curve (black), departing from the thermal Hawking result (red). Error bars show mean $\pm $ 1$\sigma $ over 100 runs}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm  BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow  {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \ref {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\ref {sec:page_theorem}).}}{46}{figure.5}\protected@file@percent }
\newlabel{fig:page_curve_exact}{{5}{46}{Exact small-comb simulation ($S_0=8$ bits, 8 steps): $S(R_{\le n})$ averaged over 50 runs. Assuming strong scrambling (P2, Haar-random unitaries). The memory dimension decrease (emulating the shrinking $S_{\rm BH}$) is implemented via a CPTP map, realized unitarily by an isometric dilation ($M_{n-1}\xrightarrow {V_n} M_n E_n$) followed by tracing out the ancilla $E_n$ (see \Cref {app:decoupling}). This procedure correctly reproduces the Page curve turnover (cf.~\cref {sec:page_theorem})}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Non-Markovian Signatures: Temporal Correlations}{46}{subsection.5.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces $g^{(2)}(\Delta u)$ (defined in \ref {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \ref {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm  mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory.}}{46}{figure.6}\protected@file@percent }
\newlabel{fig:g2}{{6}{46}{$g^{(2)}(\Delta u)$ (defined in \Cref {sec:methods}) showing oscillatory, exponentially decaying comb sidebands with 95\% confidence intervals across 200 runs. Parameters correspond to the nominal case in \Cref {tab:ablation} (scrambling strength 1.0, gentleness $\varepsilon =0.08$, memory depth $\ell _{\rm mem} \approx 4$). This deviation from the thermal baseline ($g^{(2)}=1$) is a direct signature of non-Markovian memory}{figure.6}{}}
